SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_HOOK_SIGNING_SECRET=
IDENTITY_HMAC_KEY=
DISCORD_WEBHOOK_URL=
GOOGLE_CLOUD_PROJECT=
OPENAI_API_KEY=
PHONE_ENCRYPTION_KEY=
# 탈퇴 때 카카오 연결 끊기용 앱 어드민 키. 비어 있으면 그 단계만 건너뛴다(서버는 그대로 뜬다).
KAKAO_ADMIN_KEY=
# 탈퇴 때 애플 토큰 철회용 Sign in with Apple 키(팀 ID · 키 ID · .p8 PEM 본문). 하나라도 비면 그 단계만 건너뛴다.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 아이폰 하트 구매 확인용 앱 내 구입 키(키 ID · 발급자 ID · .p8 PEM 본문). 위 애플 키와 다른 키다. 하나라도 비면 아이폰 결제 확인만 503.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# 문의하기 알림 메일(구글 앱 비밀번호). 비어 있으면 메일만 건너뛴다 — 문의 저장은 그대로 된다. 받는 곳 · 보내는 계정은 기본값이 운영 메일이다.
INQUIRY_SMTP_PASSWORD=
# 휴대폰 문자 인증. fake(기본)는 로컬 스택에서만 쓰고 운영 주소면 503 이다. 운영은 solapi + 아래 세 값(Secret Manager).
SMS_PROVIDER=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 하루(한국 시간) 전체 발송 상한(기본 300). 빈 값은 부팅을 막으니 바꿀 때만 숫자를 넣는다.
SMS_DAILY_GLOBAL_LIMIT=300
# true 면 기본 정보 저장이 인증한 번호만 받는다. 인증하는 새 앱이 나간 뒤에 켠다(기본 false).
PHONE_VERIFICATION_REQUIRED=false
