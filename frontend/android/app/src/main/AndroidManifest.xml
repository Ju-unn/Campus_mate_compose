<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 13+ 는 알림을 보내기 전에 사용자에게 물어봐야 한다(조각 4). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 지인 차단: 번호를 읽기만 한다. 패키지가 쓰기 권한을 붙여 와도 병합에서 뺀다(계획서 "새 의존성"). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />
    <!-- 광고 식별자는 쓰지 않는다(사용 통계는 광고용이 아니다, 2026-10-20). 분석 SDK 가 붙여 오는 이 두 권한을 병합에서 뺀다 —
         남겨 두면 구글 플레이 "광고 ID" 신고 대상이 된다. 아래 adid 수집 끄기와 함께 간다. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <!-- 백업은 끈다 — 로그인 토큰 · 온보딩 임시 저장이 구글 드라이브 백업 · adb backup 으로 기기 밖에 나가지 않게
         (2026-10-12 보안 점검 #15). 기기를 바꾸면 다시 로그인한다. -->
    <application
        android:label="CampusMate"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 앱은 주소로 화면을 열 일이 없다(푸시 이동은 앱 안 router.go). 켜 두면 이 화면으로 온 VIEW 인텐트의 주소가
                 그대로 라우터 경로가 된다(2026-10-18 보안 검사). 카카오 로그인 복귀는 아래 AuthCodeHandlerActivity 가 따로 받는다. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 카카오톡 공유 카드의 "가입하러 가기"로 앱을 연다(kakao{키}://kakaolink). 코드 자동 입력은 하지 않고 앱만 연다.
                 kakaoKey 는 build.gradle.kts 가 넣는다. kakao_flutter_sdk_common 플러그인이 이 host 만 골라 받는다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoKey}" android:host="kakaolink" />
            </intent-filter>
        </activity>
        <!-- 카카오 로그인(카카오 계정 · 카카오톡)이 끝나고 앱으로 돌아오는 화면. 클래스 이름은 kakao_flutter_sdk_auth 2.0.1 의
             것 그대로여야 한다(다르면 로그인 뒤 앱이 죽는다). kakaoKey 는 build.gradle.kts 가 넣는다(키는 저장소에 없음).
             카카오톡 앱 조회용 <queries>(com.kakao.talk)는 kakao_flutter_sdk_common 매니페스트에 이미 있어 병합으로 들어온다. -->
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoKey}" android:host="oauth" />
            </intent-filter>
        </activity>
        <!-- 앱이 꺼져 있을 때 시스템이 알림을 띄울 채널. 지정하지 않으면 안드로이드가 경고를 남긴다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="campus_mate_default" />
        <!-- 알림 줄 작은 아이콘(흰색 + 투명 실루엣). 없으면 FCM 이 앱 아이콘을 써서 흰 네모로 보인다.
             앱이 떠 있을 때 앱이 직접 띄우는 알림(local_system_notifications.dart)도 같은 그림을 쓴다.
             여기서 참조하므로 릴리스 빌드의 리소스 줄이기(R8)가 이 그림을 지우지 않는다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_campusmate" />
        <!-- 작은 아이콘 뒤 원 색. 앱 대표 색(AppColors.primary). 앱이 직접 띄우는 알림은 local_system_notifications.dart 가 같은 색을 준다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- 사용 통계(Firebase Analytics) · 오류 수집(Crashlytics) · 성능 측정은 약관 동의 전에는 꺼 둔다(2026-10-20).
             동의를 마친 로그인 사용자일 때만 앱이 켠다(lib/core/analytics/collection_consent.dart). 켠 값은 Firebase 가 기기에 기억한다. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <!-- 성능 측정(Firebase Performance)도 같다. 자동 수집만 쓰고 사용자 지정 추적(HttpMetric · Trace)은 만들지 않는다.
             firebase_performance_collection_deactivated 는 쓰지 않는다 — 그 값은 앱에서 다시 켤 수 없다. -->
        <meta-data android:name="firebase_performance_collection_enabled" android:value="false" />
        <!-- 광고 식별자 수집 · 광고 맞춤 신호는 켜 두지 않는다(사용 통계는 광고용이 아니다). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
